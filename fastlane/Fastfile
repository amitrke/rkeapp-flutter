require 'google/apis/androidpublisher_v3'
require 'googleauth'

default_platform(:android)

platform :android do
  desc "Upload curated Android screenshots to Google Play"
  lane :upload_screenshots do
    repo_root = File.expand_path("..", __dir__)
    metadata_path = File.join(repo_root, "fastlane", "metadata", "android")
    screenshots_source = File.join(repo_root, "screenshots", "store", "android")

    phone_target = File.join(metadata_path, "en-US", "images", "phoneScreenshots")
    seven_inch_target = File.join(metadata_path, "en-US", "images", "sevenInchScreenshots")
    ten_inch_target = File.join(metadata_path, "en-US", "images", "tenInchScreenshots")

    FileUtils.rm_rf(metadata_path)
    FileUtils.mkdir_p(phone_target)
    FileUtils.mkdir_p(seven_inch_target)
    FileUtils.mkdir_p(ten_inch_target)

    phone_screenshots = Dir.glob(File.join(screenshots_source, "phone", "*.png")).sort
    tablet7_screenshots = Dir.glob(File.join(screenshots_source, "tablet-7", "*.png")).sort
    tablet10_screenshots = Dir.glob(File.join(screenshots_source, "tablet-10", "*.png")).sort

    UI.user_error!("No phone screenshots found in screenshots/store/android/phone") if phone_screenshots.empty?

    phone_screenshots.each { |path| FileUtils.cp(path, phone_target) }
    tablet7_screenshots.each { |path| FileUtils.cp(path, seven_inch_target) }
    tablet10_screenshots.each { |path| FileUtils.cp(path, ten_inch_target) }

    UI.message("Copied #{phone_screenshots.length} phone screenshots")
    UI.message("Copied #{tablet7_screenshots.length} 7-inch tablet screenshots")
    UI.message("Copied #{tablet10_screenshots.length} 10-inch tablet screenshots")

    # Use the Play Developer API directly to avoid supply's mandatory
    # edits.tracks.update call, which always creates a release and fails
    # on draft apps regardless of the release_status parameter.
    package_name  = ENV.fetch("ANDROID_PACKAGE_NAME", "org.roorkee")
    json_key_path = ENV.fetch("SUPPLY_JSON_KEY")

    Pub = Google::Apis::AndroidpublisherV3
    service = Pub::AndroidPublisherService.new
    service.authorization = Google::Auth::ServiceAccountCredentials.make_creds(
      json_key_io: File.open(json_key_path),
      scope: Pub::AUTH_ANDROIDPUBLISHER
    )

    edit = service.insert_edit(package_name)
    UI.message("Opened Play Store edit #{edit.id}")

    {
      "phoneScreenshots"     => phone_target,
      "sevenInchScreenshots" => seven_inch_target,
      "tenInchScreenshots"   => ten_inch_target,
    }.each do |image_type, folder|
      pngs = Dir.glob(File.join(folder, "*.png")).sort
      next if pngs.empty?

      service.delete_all_edit_images(package_name, edit.id, "en-US", image_type)
      UI.message("Cleared existing #{image_type}")

      pngs.each do |path|
        service.upload_edit_image(
          package_name, edit.id, "en-US", image_type,
          upload_source: path,
          content_type: "image/png"
        )
        UI.message("  ↑ #{File.basename(path)}")
      end
    end

    service.commit_edit(package_name, edit.id)
    UI.success("Android screenshots uploaded and committed to Google Play")
  end

  desc "Upload store listing metadata (title, description, changelogs) to Google Play"
  lane :upload_metadata do
    repo_root = File.expand_path("..", __dir__)
    metadata_path = File.join(repo_root, "fastlane", "metadata", "android")

    upload_to_play_store(
      json_key: ENV.fetch("SUPPLY_JSON_KEY"),
      package_name: ENV.fetch("ANDROID_PACKAGE_NAME", "org.roorkee"),
      track: ENV.fetch("PLAY_STORE_TRACK", "internal"),
      release_status: "draft",
      metadata_path: metadata_path,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    UI.success("Android store listing metadata uploaded to Google Play")
  end

  desc "Promote the internal track release to production"
  lane :promote_to_production do
    upload_to_play_store(
      json_key: ENV.fetch("SUPPLY_JSON_KEY"),
      package_name: ENV.fetch("ANDROID_PACKAGE_NAME", "org.roorkee"),
      track: "internal",
      track_promote_to: "production",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )

    UI.success("Android release promoted to production on Google Play")
  end

  desc "Create curated Android screenshot folders"
  lane :prepare_screenshots do
    repo_root = File.expand_path("..", __dir__)
    FileUtils.mkdir_p(File.join(repo_root, "screenshots", "store", "android", "phone"))
    FileUtils.mkdir_p(File.join(repo_root, "screenshots", "store", "android", "tablet-7"))
    FileUtils.mkdir_p(File.join(repo_root, "screenshots", "store", "android", "tablet-10"))
    UI.success("Prepared screenshots/store/android/{phone,tablet-7,tablet-10}")
  end
end

platform :ios do
  desc "Upload curated iOS screenshots to App Store Connect"
  lane :upload_screenshots do
    repo_root = File.expand_path("..", __dir__)
    screenshots_source = File.join(repo_root, "screenshots", "store", "ios")
    screenshots_dest = File.join(repo_root, "fastlane", "screenshots", "en-US")

    FileUtils.rm_rf(File.join(repo_root, "fastlane", "screenshots"))
    FileUtils.mkdir_p(screenshots_dest)

    # Map our folder names to App Store Connect device type prefixes
    device_map = {
      "iphone-6.5" => "iPhone6.5",
      "ipad-12.9"  => "iPadPro129"
    }

    device_map.each do |folder, prefix|
      sources = Dir.glob(File.join(screenshots_source, folder, "*.png")).sort
      UI.user_error!("No screenshots found in screenshots/store/ios/#{folder}") if folder == "iphone-6.5" && sources.empty?
      sources.each_with_index do |path, idx|
        dest_name = "#{prefix}-#{format('%02d', idx + 1)}.png"
        FileUtils.cp(path, File.join(screenshots_dest, dest_name))
      end
      UI.message("Copied #{sources.length} #{folder} screenshots as #{prefix}-*.png")
    end

    api_key = app_store_connect_api_key(
      key_id:      ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id:   ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true
    )

    upload_to_app_store(
      api_key:              api_key,
      app_identifier:       ENV.fetch("IOS_APP_IDENTIFIER", "org.roorkee"),
      screenshots_path:     File.join(repo_root, "fastlane", "screenshots"),
      skip_binary_upload:   true,
      skip_metadata:        true,
      overwrite_screenshots: true,
      submit_for_review:    false,
      force:                true
    )

    UI.success("iOS screenshots uploaded to App Store Connect")
  end

  desc "Upload store listing metadata (description, keywords, release notes) to App Store Connect"
  lane :upload_metadata do
    repo_root = File.expand_path("..", __dir__)

    api_key = app_store_connect_api_key(
      key_id:      ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id:   ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true
    )

    upload_to_app_store(
      api_key:            api_key,
      app_identifier:     ENV.fetch("IOS_APP_IDENTIFIER", "org.roorkee"),
      metadata_path:      File.join(repo_root, "fastlane", "metadata", "ios"),
      skip_binary_upload: true,
      skip_screenshots:   true,
      submit_for_review:  false,
      force:              true
    )

    UI.success("iOS store listing metadata uploaded to App Store Connect")
  end

  desc "Submit the latest approved build for App Store review"
  lane :submit_for_review do
    api_key = app_store_connect_api_key(
      key_id:      ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id:   ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_API_KEY"),
      is_key_content_base64: true
    )

    upload_to_app_store(
      api_key:            api_key,
      app_identifier:     ENV.fetch("IOS_APP_IDENTIFIER", "org.roorkee"),
      skip_binary_upload: true,
      skip_screenshots:   true,
      skip_metadata:      true,
      submit_for_review:  true,
      automatic_release:  false,
      force:              true,
      submission_information: {
        add_id_info_uses_idfa:                   false,
        export_compliance_uses_encryption:        false,
        export_compliance_encryption_updated:     false
      }
    )

    UI.success("iOS app submitted for App Store review")
  end

  desc "Create curated iOS screenshot folders"
  lane :prepare_screenshots do
    repo_root = File.expand_path("..", __dir__)
    FileUtils.mkdir_p(File.join(repo_root, "screenshots", "store", "ios", "iphone-6.5"))
    FileUtils.mkdir_p(File.join(repo_root, "screenshots", "store", "ios", "ipad-12.9"))
    UI.success("Prepared screenshots/store/ios/{iphone-6.5,ipad-12.9}")
  end
end
