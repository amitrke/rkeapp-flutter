# Copy this file to .env and fill in your own values.
# Register APP_CHECK_DEBUG_TOKEN in Firebase Console →
# App Check → Apps → RkeApp (iOS) → Manage debug tokens
APP_CHECK_DEBUG_TOKEN=your-uuid-here

# Optional override for screenshot target folder when running Maestro manually.
# Runner scripts set this automatically to screenshots/{device-id}.
# MAESTRO_SCREENSHOT_DIR=screenshots/default
